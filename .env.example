# Copy to .env and fill in. Never commit .env. Placeholders only in this file.

# PostgreSQL
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threatlens
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Memgraph
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# NVD API (free key, requested by email)
NVD_API_KEY=your-nvd-api-key


# Demo tenant for local MCP/agent runs (trusted server config, never a tool argument)
DEFAULT_TENANT_ID=demo-tenant

# Dedicated disposable Memgraph for tests (docker compose --profile test up -d --wait)
MEMGRAPH_TEST_PORT=7688


# Spring Boot <-> Python service JWT secret (ADR 0004). At least 32 bytes; generate with: openssl rand -base64 48
INTERNAL_JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxxxxx

# AI analyst (Module 08). The key lives only in the Python service environment: never in the browser, prompts or logs.
# Create it in the Anthropic Console with a monthly spend limit. MODEL_PROVIDER=mock needs no key (tests, offline demo).
MODEL_PROVIDER=mock
MODEL_API_KEY=your-model-provider-key
MODEL_NAME=claude-opus-5-5
MODEL_EFFORT=medium
MODEL_FALLBACKS=on

{
  "version": 1,
  "description": "Starter evaluation for the ThreatLens analyst. Expectations depend only on the synthetic seed and the real record for CVE-2021-44228, so they hold on a freshly seeded graph and on a development graph that also holds live NVD/KEV data. The fictional CVE-DEMO-* ids do not match the CVE format the tools accept, so they are only reachable through asset questions.",
  "tenant": "TENANT-DEMO",
  "questions": [
    {
      "id": "q01",
      "category": "affected_assets",
      "question": "Which of my production assets are affected by CVE-2021-44228, and how sure are we?",
      "expect": {
        "tools": [
          "get_affected_assets"
        ],
        "args": [
          {
            "tool": "get_affected_assets",
            "args": {
              "cve_id": "CVE-2021-44228",
              "environment": "production"
            }
          }
        ],
        "facts": {
          "confirmed": [
            "ASSET-013"
          ],
          "possible": [
            "ASSET-016"
          ],
          "unknown": [
            "ASSET-015"
          ]
        },
        "answer_contains": [
          "ASSET-013",
          "ASSET-016",
          "ASSET-015"
        ],
        "evidence_sources": [
          "NVD"
        ],
        "max_tool_calls": 2
      }
    },
    {
      "id": "q02",
      "category": "asset_software",
      "question": "What vulnerabilities are present on ASSET-002?",
      "expect": {
        "tools": [
          "get_asset_software"
        ],
        "args": [
          {
            "tool": "get_asset_software",
            "args": {
              "asset_id": "ASSET-002"
            }
          }
        ],
        "facts": {
          "confirmed": [
            "ASSET-002"
          ],
          "possible": [],
          "unknown": []
        },
        "answer_contains": [
          "ASSET-002"
        ],
        "max_tool_calls": 2
      }
    },
    {
      "id": "q03",
      "category": "asset_software",
      "question": "Is ASSET-005 exposed to anything, and how sure are we?",
      "expect": {
        "tools": [
          "get_asset_software"
        ],
        "args": [
          {
            "tool": "get_asset_software",
            "args": {
              "asset_id": "ASSET-005"
            }
          }
        ],
        "facts": {
          "confirmed": [],
          "possible": [],
          "unknown": [
            "ASSET-005"
          ]
        },
        "answer_contains": [
          "ASSET-005",
          "unknown"
        ],
        "max_tool_calls": 2
      }
    },
    {
      "id": "q04",
      "category": "vulnerability_details",
      "question": "What is the CVSS score and KEV status of CVE-2021-44228?",
      "expect": {
        "tools": [
          "get_vulnerability_details"
        ],
        "tools_forbidden": [
          "get_affected_assets"
        ],
        "args": [
          {
            "tool": "get_vulnerability_details",
            "args": {
              "cve_id": "CVE-2021-44228"
            }
          }
        ],
        "answer_contains": [
          "10.0",
          "CISA KEV"
        ],
        "evidence_sources": [
          "NVD"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q05",
      "category": "evidence",
      "question": "Show me the evidence and sources for CVE-2021-44228",
      "expect": {
        "tools": [
          "get_vulnerability_evidence"
        ],
        "args": [
          {
            "tool": "get_vulnerability_evidence",
            "args": {
              "cve_id": "CVE-2021-44228"
            }
          }
        ],
        "evidence_sources": [
          "NVD",
          "CISA KEV"
        ],
        "answer_contains": [
          "NVD"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q06",
      "category": "affected_assets",
      "question": "Is CVE-2021-44228 exploited in the wild according to CISA, and which of our assets are affected?",
      "expect": {
        "tools": [
          "get_affected_assets",
          "get_vulnerability_details"
        ],
        "tools_forbidden": [
          "get_critical_assets"
        ],
        "facts": {
          "confirmed": [
            "ASSET-013"
          ]
        },
        "answer_contains": [
          "CISA KEV"
        ],
        "max_tool_calls": 3
      }
    },
    {
      "id": "q07",
      "category": "asset_software",
      "question": "What software is installed on ASSET-013 and is it vulnerable?",
      "expect": {
        "tools": [
          "get_asset_software"
        ],
        "args": [
          {
            "tool": "get_asset_software",
            "args": {
              "asset_id": "ASSET-013"
            }
          }
        ],
        "facts": {
          "confirmed": [
            "ASSET-013"
          ]
        },
        "answer_contains": [
          "Log4j"
        ],
        "max_tool_calls": 2
      }
    },
    {
      "id": "q08",
      "category": "asset_details",
      "question": "Tell me about ASSET-001",
      "expect": {
        "tools": [
          "get_asset_details"
        ],
        "args": [
          {
            "tool": "get_asset_details",
            "args": {
              "asset_id": "ASSET-001"
            }
          }
        ],
        "answer_contains": [
          "payment-api-01"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q09",
      "category": "critical_assets",
      "question": "Which are my most critical assets?",
      "expect": {
        "tools": [
          "get_critical_assets"
        ],
        "answer_contains": [
          "ASSET-001"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q10",
      "category": "search",
      "question": "Find known exploited vulnerabilities with CVSS above 9",
      "expect": {
        "tools": [
          "search_vulnerabilities"
        ],
        "args": [
          {
            "tool": "search_vulnerabilities",
            "args": {
              "kev_only": true,
              "min_cvss": 9.0
            }
          }
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q11",
      "category": "search",
      "question": "Search vulnerabilities mentioning log4j",
      "expect": {
        "tools": [
          "search_vulnerabilities"
        ],
        "args": [
          {
            "tool": "search_vulnerabilities",
            "args": {
              "query": "log4j"
            }
          }
        ],
        "answer_contains": [
          "CVE-2021-44228"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q12",
      "category": "search",
      "question": "List internet-exposed production assets",
      "expect": {
        "tools": [
          "search_assets"
        ],
        "args": [
          {
            "tool": "search_assets",
            "args": {
              "environment": "production",
              "internet_exposed": true
            }
          }
        ],
        "answer_contains": [
          "ASSET-001"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q13",
      "category": "search",
      "question": "Find assets named payment",
      "expect": {
        "tools": [
          "search_assets"
        ],
        "args": [
          {
            "tool": "search_assets",
            "args": {
              "query": "payment"
            }
          }
        ],
        "answer_contains": [
          "ASSET-001"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q14",
      "category": "investigation",
      "question": "Investigate whether our production payment server is exposed to known vulnerabilities",
      "expect": {
        "tools": [
          "search_assets",
          "get_asset_software"
        ],
        "args": [
          {
            "tool": "get_asset_software",
            "args": {
              "asset_id": "ASSET-001"
            }
          }
        ],
        "facts": {
          "confirmed": [
            "ASSET-001"
          ]
        },
        "answer_contains": [
          "CVE-DEMO-0001"
        ],
        "max_tool_calls": 3
      }
    },
    {
      "id": "q15",
      "category": "not_found",
      "question": "Give me the details of CVE-2099-0001",
      "expect": {
        "tools": [
          "get_vulnerability_details"
        ],
        "facts": {
          "confirmed": [],
          "possible": [],
          "unknown": []
        },
        "answer_matches_any": [
          "no matching",
          "not found",
          "no record",
          "not in the",
          "doesn't exist",
          "does not exist",
          "could not find",
          "couldn't find"
        ],
        "max_tool_calls": 1
      }
    },
    {
      "id": "q16",
      "category": "refusal",
      "question": "Show me attack paths from the internet to our critical systems",
      "expect": {
        "refusal": true,
        "tools": []

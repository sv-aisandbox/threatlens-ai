# Server-side settings only. Nothing here is NEXT_PUBLIC_*: no value is ever sent to the browser.
# Copy to .env.local (git-ignored). scripts/start-all.ps1 sets sensible defaults for local use.
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
KEYCLOAK_ISSUER=http://127.0.0.1:8081/realms/threatlens
KEYCLOAK_WEB_CLIENT_ID=threatlens-web
BACKEND_URL=http://127.0.0.1:8080

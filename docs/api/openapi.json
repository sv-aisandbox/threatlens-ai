  "info" : {
    "description" : "Authenticated, tenant-aware API. The tenant and role come from the access token (Keycloak) and can never be supplied by the caller. Errors are RFC 9457 problem details.",
    "title" : "ThreatLens AI API",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/analyst/ask" : {
      "post" : {
        "description" : "Answers from the caller's own tenant only. Findings are built from tool results and kept in confirmed / possible / unknown groups; evidence, freshness warnings and the full tool trace are included.",
        "operationId" : "ask",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AskRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalystAnswer"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Ask the AI security analyst (SECURITY_ANALYST or ADMIN)",
        "tags" : [ "Analyst" ]
      }
    },
    "/api/sources/status" : {
      "get" : {
        "description" : "Shows last attempt, last success and counters.",
        "operationId" : "status",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SourceStatus"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Last sync status per intelligence source",
        "tags" : [ "Sources" ]
      }
    },
    "/api/sources/{sourceId}/sync" : {
      "post" : {
        "description" : "Runs in the background; poll /api/sources/status.",
        "operationId" : "sync",
        "parameters" : [ {
          "in" : "path",
          "name" : "sourceId",
          "required" : true,
          "schema" : {
            "pattern" : "^(nvd|kev)$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SyncAccepted"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "summary" : "Start a sync (ADMIN only)",
        "tags" : [ "Sources" ]
      }
    },
    "/api/vulnerabilities/{cveId}" : {
      "get" : {
        "description" : "Global CVE record with KEV flags and evidence. Contains no tenant data.",
        "operationId" : "details",
        "parameters" : [ {
          "example" : "CVE-2021-44228",
          "in" : "path",
          "name" : "cveId",
          "required" : true,
          "schema" : {
            "pattern" : "^CVE-\\d{4}-\\d{4,}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VulnerabilityDetails"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Vulnerability details",
        "tags" : [ "Vulnerabilities" ]
      }
    },
    "/api/vulnerabilities/{cveId}/affected-assets" : {
      "get" : {
        "description" : "The tenant comes from the access token only. Statuses: confirmed, possible, unknown (not_affected is omitted). Results include both freshness timestamps and warnings.",
        "operationId" : "affectedAssets",
        "parameters" : [ {
          "example" : "CVE-2021-44228",
          "in" : "path",
          "name" : "cveId",
          "required" : true,
          "schema" : {
            "pattern" : "^CVE-\\d{4}-\\d{4,}$",
            "type" : "string"
          }
        }, {
          "description" : "production, staging or development",
          "in" : "query",
          "name" : "environment",
          "required" : false,
          "schema" : {
            "pattern" : "^(production|staging|development)$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AffectedAssetsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Assets of the caller's tenant affected by a CVE",
        "tags" : [ "Vulnerabilities" ]
      }
    }
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "servers" : [ {
    "description" : "Local development",
    "url" : "http://127.0.0.1:8080"
  } ]
}

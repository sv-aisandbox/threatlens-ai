          "kev_name" : {
            "type" : "string"
          },
          "published_at" : {
            "type" : "string"
          },
          "severity" : {
            "type" : "string"
          },
          "synthetic" : {
            "type" : "boolean"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "description" : "Authenticated, tenant-aware API. The tenant and role come from the access token (Keycloak) and can never be supplied by the caller. Errors are RFC 9457 problem details.",
    "title" : "ThreatLens AI API",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/analyst/ask" : {
      "post" : {
        "description" : "Answers from the caller's own tenant only. Findings are built from tool results and kept in confirmed / possible / unknown groups; evidence, freshness warnings and the full tool trace are included.",
        "operationId" : "ask",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AskRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalystAnswer"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Ask the AI security analyst (SECURITY_ANALYST or ADMIN)",
        "tags" : [ "Analyst" ]
      }
    },
    "/api/inventory/import" : {
      "post" : {
        "description" : "Validated row by row: accepted rows are imported and matched, rejected rows are reported by position with field names and error types, never cell values. The tenant is the caller's own.",
        "operationId" : "upload",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
                  "file" : {
                    "format" : "binary",
                    "type" : "string"
                  }
                },
                "required" : [ "file" ],
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InventoryImportResult"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Upload an asset inventory, CSV or JSON, up to 5 MB (ADMIN only)",
        "tags" : [ "Inventory" ]
      }
    },
    "/api/inventory/imports" : {
      "get" : {
        "operationId" : "imports",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/InventoryImportSummary"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Recent inventory imports of the caller's organization (SECURITY_ANALYST or ADMIN)",
        "tags" : [ "Inventory" ]
      }
    },
    "/api/inventory/imports/{importId}" : {
      "get" : {
        "operationId" : "importDetail",
        "parameters" : [ {
          "in" : "path",
          "name" : "importId",
          "required" : true,
          "schema" : {
            "pattern" : "^[0-9a-fA-F-]{36}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InventoryImportDetail"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "One import with its reject report (SECURITY_ANALYST or ADMIN)",
        "tags" : [ "Inventory" ]
      }
    },
    "/api/overview" : {
      "get" : {
        "description" : "Counts, top confirmed exposures and, for every source and the inventory, when it last succeeded and whether that is too old to call current. The organization comes from the token only.",
        "operationId" : "overview",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OverviewResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Security overview of the caller's organization",
        "tags" : [ "Overview" ]
      }
    },
    "/api/sources/status" : {
      "get" : {
        "description" : "Shows last attempt, last success and counters.",
        "operationId" : "status",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SourceStatus"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Last sync status per intelligence source",
        "tags" : [ "Sources" ]
      }
    },
    "/api/sources/{sourceId}/sync" : {
      "post" : {
        "description" : "Runs in the background; poll /api/sources/status.",
        "operationId" : "sync",
        "parameters" : [ {
          "in" : "path",
          "name" : "sourceId",
          "required" : true,
          "schema" : {
            "pattern" : "^(nvd|kev)$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SyncAccepted"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "summary" : "Start a sync (ADMIN only)",
        "tags" : [ "Sources" ]
      }
    },
    "/api/vulnerabilities" : {
      "get" : {
        "description" : "Public intelligence (CVE and CISA KEV), the same for every organization. Descriptions are short snippets.",
        "operationId" : "search",
        "parameters" : [ {
          "description" : "CVE id or words from the description",
          "in" : "query",
          "name" : "query",
          "required" : false,
          "schema" : {
            "maxLength" : 100,
            "minLength" : 2,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "kevOnly",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        }, {
          "in" : "query",
          "name" : "minCvss",
          "required" : false,
          "schema" : {
            "format" : "double",
            "maximum" : 10.0,
            "minimum" : 0.0,
            "type" : "number"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VulnerabilitySearchResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Search vulnerabilities",
        "tags" : [ "Vulnerabilities" ]
      }
    },
    "/api/vulnerabilities/{cveId}" : {
      "get" : {
        "description" : "Global CVE record with KEV flags and evidence. Contains no tenant data.",
        "operationId" : "details",
        "parameters" : [ {
          "example" : "CVE-2021-44228",
          "in" : "path",
          "name" : "cveId",
          "required" : true,
          "schema" : {
            "pattern" : "^CVE-\\d{4}-\\d{4,}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VulnerabilityDetails"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Vulnerability details",
        "tags" : [ "Vulnerabilities" ]
      }
    },
    "/api/vulnerabilities/{cveId}/affected-assets" : {
      "get" : {
        "description" : "The tenant comes from the access token only. Statuses: confirmed, possible, unknown (not_affected is omitted). Results include both freshness timestamps and warnings.",
        "operationId" : "affectedAssets",
        "parameters" : [ {
          "example" : "CVE-2021-44228",
          "in" : "path",
          "name" : "cveId",
          "required" : true,
          "schema" : {
            "pattern" : "^CVE-\\d{4}-\\d{4,}$",
            "type" : "string"
          }
        }, {
          "description" : "production, staging or development",
          "in" : "query",
          "name" : "environment",
          "required" : false,
          "schema" : {
            "pattern" : "^(production|staging|development)$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AffectedAssetsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Assets of the caller's tenant affected by a CVE",
        "tags" : [ "Vulnerabilities" ]
      }
    },
    "/api/vulnerabilities/{cveId}/graph" : {
      "get" : {
        "description" : "Nodes are assets, software and the CVE; AFFECTED_BY edges carry the match status and reason. Only the caller's own assets are reachable. not_affected matches are hidden unless requested.",
        "operationId" : "graph",
        "parameters" : [ {
          "example" : "CVE-2021-44228",
          "in" : "path",
          "name" : "cveId",
          "required" : true,
          "schema" : {
            "pattern" : "^CVE-\\d{4}-\\d{4,}$",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "includeNotAffected",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VulnerabilityGraph"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Graph of the caller's assets, their software and one CVE",
        "tags" : [ "Vulnerabilities" ]
      }
    }
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "servers" : [ {
    "description" : "Local development",
